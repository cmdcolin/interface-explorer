{
  "name": "interface-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "atlas": "node src/atlas.ts",
    "clinvar": "node src/clinvar.ts",
    "alphamissense": "node src/alphamissense.ts",
    "analyze": "node src/analyze.ts",
    "experimental": "node src/experimental.ts",
    "gpcr": "node src/gpcr.ts",
    "tracks": "node src/tracks.ts",
    "pages": "node src/pages.ts",
    "isoforms": "node src/isoforms.ts",
    "all": "pnpm atlas && pnpm clinvar && pnpm alphamissense && pnpm analyze && pnpm experimental && pnpm gpcr && pnpm tracks && pnpm pages && pnpm isoforms",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && astro check --tsconfig web/tsconfig.json",
    "format": "prettier --write src"
  },
  "dependencies": {
    "g2p_mapper": "^2.3.1",
    "p2s_mapper": "^3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.4",
    "@types/node": "^24.0.0",
    "astro": "^7.4.10",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "proseWrap": "always"
  }
}
