{
  "name": "interface-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "atlas": "node src/atlas.ts",
    "clinvar": "node src/clinvar.ts",
    "alphamissense": "node src/alphamissense.ts",
    "interactions": "node src/interactions.ts",
    "analyze": "node src/analyze.ts",
    "conservation": "node src/conservation.ts",
    "experimental": "node src/experimental.ts",
    "gnomad": "node src/gnomad.ts",
    "gpcr": "node src/gpcr.ts",
    "viral": "node src/viral.ts",
    "md": "node src/md.ts",
    "tracks": "node src/tracks.ts",
    "pages": "node src/pages.ts",
    "findings": "node src/findings.ts",
    "isoforms": "node src/isoforms.ts",
    "heroes": "node src/heroes.ts",
    "all": "pnpm atlas && pnpm clinvar && pnpm alphamissense && pnpm interactions && pnpm analyze && pnpm experimental && pnpm conservation && pnpm gnomad && pnpm gpcr && pnpm viral && pnpm md && pnpm tracks && pnpm pages && pnpm findings && pnpm isoforms",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && astro check --tsconfig web/tsconfig.json",
    "format": "prettier --write src",
    "check-links": "node src/checkLinks.ts dist",
    "tour": "node src/tour.ts"
  },
  "dependencies": {
    "@gmod/bbi": "^12.2.0",
    "g2p_mapper": "^2.3.1",
    "generic-filehandle2": "^2.5.1",
    "p2s_mapper": "^3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.4",
    "@types/node": "^24.0.0",
    "astro": "^7.4.10",
    "chrome-capture": "^0.1.2",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "proseWrap": "always"
  }
}
