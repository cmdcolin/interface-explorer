      "metadata": {
        "ucsc": {
          "bigDataUrl": "https://jbrowse.org/gbdb/hg38/bbi/clinvar/clinvarMain.bb",
          "decorator.default.bigDataUrl": "https://jbrowse.org/gbdb/hg38/bbi/clinvar/clinvarMainDecor.bb",
