---
import { complexSpec, genomeUrl, sessionUrl } from '../../src/links.ts'
import Layout from '../layouts/Layout.astro'
import { leadRows, summary } from '../lib/data.ts'
import { alphaMissenseNote, amCell, clinvarHref, conditionCell, esc, partnerDiseaseNotes, phylopCell } from '../lib/html.ts'
import { JBROWSE, geneHref, href } from '../lib/site.ts'
import { sortableTable } from '../lib/table.ts'

const s = summary()
const leads = leadRows()
const table = sortableTable({
  id: 'leads',
  rows: leads,
  sortBy: 3,
  noun: 'variants',
  placeholder: 'Filter genes, conditions or partners',
  search: lead => [lead.gene, lead.change, ...lead.partners, ...lead.knownConditions],
  columns: [
    { label: 'Gene', cell: lead => `<a href="${geneHref(lead.page)}">${esc(lead.gene)}</a>`, sort: lead => lead.gene },
    {
      label: 'Change',
      cell: lead => `<a href="${clinvarHref(lead.variation)}" title="${esc(lead.review)}">${esc(lead.change)}</a>`,
      sort: lead => lead.position,
    },
    {
      label: 'Condition of the pathogenic variant',
      cell: lead => conditionCell(lead.knownConditions),
      sort: lead => lead.knownConditions[0] ?? '',
    },
    { label: 'AlphaMissense', num: true, cell: lead => amCell(lead.alphaMissense), sort: lead => lead.alphaMissense ?? -1 },
    {
      label: 'Evidence',
      cell: lead =>
        lead.evidence === 'PS1'
          ? '<span class="nowrap" title="The same amino-acid change, from a different nucleotide change, is classified pathogenic">PS1 same change</span>'
          : '<span class="nowrap" title="A different substitution at this residue is classified pathogenic">PM5 same residue</span>',
      sort: lead => lead.evidence,
    },
    {
      label: 'phyloP',
      num: true,
      cell: lead => phylopCell(lead.phylop, s.conservation.variants.edges),
      sort: lead => lead.phylop ?? -99,
    },
    { label: 'Pathogenic at this residue', cell: lead => lead.sameResidue.map(esc).join(', '), sort: lead => lead.sameResidue.length },
    {
      label: 'Other pathogenic residues on the interface',
      num: true,
      cell: lead => lead.pathogenicResidues,
      sort: lead => lead.pathogenicResidues,
    },
    {
      label: 'Touches',
      cell: lead =>
        `<span class="muted">${esc(lead.partners.slice(0, 2).map(name => (name === lead.gene ? 'itself' : name)).join(', '))}${lead.partners.length > 2 ? ` +${lead.partners.length - 2}` : ''}</span>${lead.apart ? '<div class="cell-note caution" title="UniProt places one protein of every pair this residue touches only inside mitochondria and the other never in mitochondria">different compartments</div>' : ''}${partnerDiseaseNotes(lead.partnerDiseases)}`,
      sort: lead => lead.partners.join(', '),
    },
    {
      label: 'Open',
      cell: lead => {
        const loc = `chr${lead.chrom}:${lead.pos - 30}-${lead.pos + 30}`
        const variant = `chr${lead.chrom}:${lead.pos}${lead.allele ? ` ${lead.allele}` : ''}`
        return `<span class="nowrap"><a href="${geneHref(lead.page)}?partner=${encodeURIComponent(lead.partner)}&amp;residue=${lead.position}">In 3D</a> · <a href="${genomeUrl(lead.chrom, lead.pos - 30, lead.pos + 30, JBROWSE)}">Genome</a> · <a href="${sessionUrl(complexSpec(lead.gene, lead.entity, loc, variant), JBROWSE)}">3D + genome</a></span>`
      },
      sort: lead => lead.pos,
    },
  ],
})
---

<Layout title="Leads" nav="leads">
  <h1>Leads</h1>
  <p class="lede">
    {leads.length.toLocaleString()} ClinVar variants of uncertain significance, in {s.leads.genes.toLocaleString()} genes,
    that change a residue at a confident predicted interface where a substitution is already classified pathogenic. For
    {s.leads.sameChange.toLocaleString()} it is the same amino-acid change from a different nucleotide change (ACMG PS1,
    strong); for the other {(leads.length - s.leads.sameChange).toLocaleString()} a different change at that residue (PM5,
    moderate). {s.leads.apart.toLocaleString()} sit only on predicted pairs whose proteins UniProt never places in the same
    compartment, marked below; treat those with caution.
  </p>
  <p class="note">
    These are leads, not classifications. PS1 and PM5 need the pathogenic variant to be well established, and PS1 also
    needs an effect on splicing ruled out; ClinVar's classification may itself already count these codes, and a milder
    substitution at the same residue can be harmless. The explorer assigns no ACMG code for an interface; the interface offers a hypothesis for why the residue matters. phyloP is the conservation of the changed base across 100 vertebrates, the most
    conserved quarter above {s.conservation.variants.edges[2]}; it is shown, not counted, since AlphaMissense already
    draws on conservation. See <a href={href('about/')}>About</a>.
  </p>
  <p class="muted" set:html={alphaMissenseNote()} />
  <Fragment set:html={table} />
</Layout>

<script>
  import '../scripts/table.ts'
</script>
