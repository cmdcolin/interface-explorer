---
import { Image } from 'astro:assets'
import { render } from 'astro:content'

import Layout from '../../layouts/Layout.astro'
import { posts } from '../../lib/posts.ts'
import { href } from '../../lib/site.ts'

export async function getStaticPaths() {
  return (await posts()).map(post => ({ params: { id: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Layout title={post.data.title} description={post.data.description} image={post.data.hero} nav="blog">
  <article class="post">
    <p><a href={href('blog/')}>← All posts</a></p>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date}>{post.data.date}</time>
    {!post.data.heroInPost && <Image
      class="post-hero"
      src={post.data.hero}
      alt={post.data.heroAlt}
      widths={[700, 1048, 1400, 2096]}
      sizes="(max-width: 1080px) calc(100vw - 32px), 1048px"
      loading="eager"
      fetchpriority="high"
    />}
    <Content />
  </article>
</Layout>
