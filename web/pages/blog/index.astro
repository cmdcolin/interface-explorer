---
import { Image } from 'astro:assets'

import Layout from '../../layouts/Layout.astro'
import { posts } from '../../lib/posts.ts'
import { href } from '../../lib/site.ts'

const all = await posts()
---

<Layout
  title="Blog"
  description="Evidence that the predicted interfaces are worth exploring, worked examples, and how the explorer connects to BioHackathon Europe 2026 Project 9."
  nav="blog"
>
  <h1>Blog</h1>
  <p class="lede">Why the predicted interfaces are worth exploring, and worked examples of what to look at, one question at a time.</p>
  <ul class="posts">
    {
      all.map(post => (
        <li>
          <a class="post-thumb" href={href(`blog/${post.id}/`)} tabindex="-1" aria-hidden="true">
            <Image src={post.data.hero} alt="" widths={[240, 480]} sizes="240px" />
          </a>
          <div>
            <a href={href(`blog/${post.id}/`)}>{post.data.title}</a>
            <time datetime={post.data.date}>{post.data.date}</time>
            <p class="muted">{post.data.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Layout>
