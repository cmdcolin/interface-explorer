---
import Layout from '../../layouts/Layout.astro'
import { posts } from '../../lib/posts.ts'
import { href } from '../../lib/site.ts'

const all = await posts()
---

<Layout
  title="Blog"
  description="What the interface atlas finds, and how it connects to BioHackathon Europe 2026 Project 9."
  nav="blog"
>
  <h1>Blog</h1>
  <p class="lede">What the atlas finds, written up one question at a time.</p>
  <ul class="posts">
    {
      all.map(post => (
        <li>
          <a href={href(`blog/${post.id}/`)}>{post.data.title}</a>
          <time datetime={post.data.date}>{post.data.date}</time>
          <p class="muted">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
