---
import {
  complexSpec,
  geneLocus,
  genomeUrl,
  sessionUrl,
  variantSpec,
} from '../../../src/links.ts'
import Layout from '../../layouts/Layout.astro'
import { gene as readGene, geneRows, isoformIndex, summary } from '../../lib/data.ts'
import { LABEL_KEYS, amCell, chip, clinvarHref, conditionCell, esc, percent } from '../../lib/html.ts'
import { pathogenicAtSameResidue, proteinMap, variantData } from '../../lib/maps.ts'
import { initialPartner, stories, structureData } from '../../lib/structure.ts'
import { JBROWSE, geneHref, href, isoformHref } from '../../lib/site.ts'

export function getStaticPaths() {
  return geneRows().map(row => ({ params: { page: row.page } }))
}

const gene = readGene(Astro.params.page ?? '')
const { alphaMissense: am, thresholds } = summary()
const pages = new Map(geneRows().map(row => [row.accession, row.page]))
const sameResidue = pathogenicAtSameResidue(gene)
const partnerHref = (accession: string | null) => {
  const page = accession ? pages.get(accession) : undefined
  return page ? geneHref(page) : `https://www.uniprot.org/uniprotkb/${accession}`
}
const species = (organism: string) => organism.replace(/^(\w)\w* /, '$1. ')
const share = (n: number, d: number) => (d ? ` (${percent(n, d)})` : '')
const isoformRow = isoformIndex().genes.find(r => r.accession === gene.accession)
const locus = geneLocus(gene)
const pad = Math.round((gene.end - gene.start) * 0.05) + 200
const conditions = [...Map.groupBy(gene.variants.flatMap(v => v.conditions), name => name)]
  .map(([name, uses]) => [name, uses.length] as const)
  .sort((a, b) => b[1] - a[1])
const description = `${gene.gene}: ${gene.interfaceResidues} residues at a predicted interface with ${gene.partners.length} partner${gene.partners.length === 1 ? '' : 's'}, and the ${gene.variants.length} ClinVar missense variants on them.`
const partnerStories = stories(gene)
const initial = initialPartner(gene)
const structureJson = JSON.stringify(structureData(gene)).replaceAll('<', '\\u003c')
const SHOWN_PARTNERS = 3
const rows = gene.variants
  .map(v => {
    const same = sameResidue.get(v) ?? []
    const partners = gene.partners.filter(p => v.partners.includes(p.gene))
    const partnerLinks = (shown: typeof partners) =>
      shown.map(p => `<a href="${sessionUrl(variantSpec(gene, v, p), JBROWSE)}">${esc(p.gene)}</a>`).join(', ')
    return `<tr ${variantData(v, same)} data-position="${v.position}" data-partners="${esc(partners.map(p => p.gene).join(','))}" data-am="${v.alphaMissense ?? -1}">
      <td>${esc(v.change)}${same.length ? `<div class="cell-note" title="A pathogenic substitution at the same residue">pathogenic ${same.map(esc).join(', ')} here</div>` : ''}</td>
      <td class="nowrap">${chip(v.label)} <a href="${clinvarHref(v.variation)}" title="${esc(v.review)}">VCV${String(v.variation).padStart(9, '0')}</a></td>
      <td>${conditionCell(v.conditions)}</td>
      <td class="num">${amCell(v.alphaMissense, am)}</td>
      <td class="nowrap">${partnerLinks(partners.slice(0, SHOWN_PARTNERS))}${partners.length > SHOWN_PARTNERS ? `<details class="more"><summary>+${partners.length - SHOWN_PARTNERS} more</summary>${partnerLinks(partners.slice(SHOWN_PARTNERS))}</details>` : ''}</td>
      <td class="nowrap"><a href="${genomeUrl(v.chrom, v.pos - 30, v.pos + 30, JBROWSE)}">chr${esc(v.chrom)}:${v.pos.toLocaleString()}</a></td>
    </tr>`
  })
  .join('')
---

<Layout title={gene.gene} description={description} nav="genes">
  <p><a href={href('genes/')}>← All genes</a></p>
  <h1>{gene.gene}</h1>
  <p class="lede">
    UniProt <a href={`https://www.uniprot.org/uniprotkb/${gene.accession}`}>{gene.accession}</a>,
    {gene.length} residues, chr{gene.chrom}:{gene.start.toLocaleString()}–{gene.end.toLocaleString()} ({gene.strand}).
    {gene.interfaceResidues} of its residues{share(gene.interfaceResidues, gene.length)} sit at a predicted interface
    (ipSAE ≥ {thresholds.ipsae}, residue pLDDT ≥ {thresholds.plddt}, within {thresholds.contact} Å of the partner).
    They hold {gene.counts.pathogenic} of its {gene.totals.pathogenic} pathogenic missense variants{share(gene.counts.pathogenic, gene.totals.pathogenic)}
    and {gene.counts.benign} of its {gene.totals.benign} benign ones{share(gene.counts.benign, gene.totals.benign)}.
  </p>
  <div class="actions">
    <a class="button primary" href={genomeUrl(gene.chrom, gene.start - pad, gene.end + pad, JBROWSE)}>View on the genome</a>
    <a class="button" href={`https://genomes.jbrowse.org/protein-browser/?gene=${encodeURIComponent(gene.gene)}`}>Open in the protein browser</a>
    <a class="button" href={`https://alphafold.ebi.ac.uk/entry/${gene.accession}`}>AlphaFold DB entry</a>
    {isoformRow && <a class="button" href={isoformHref(isoformRow.page)}>Isoforms ({isoformRow.modelled})</a>}
  </div>
  {
    partnerStories.length > 0 && (
      <section class="structure-section">
        <div class="structure-head">
          <h2>In 3D</h2>
          <div class="partner-picks">
            {partnerStories.map(s => (
              <button type="button" class="partner-pick" data-partner={s.gene} aria-pressed={s.gene === initial ? 'true' : 'false'}>
                {s.gene}
                {s.pathogenic > 0 && <span class="pick-count" title={`${s.pathogenic} pathogenic variants at this interface`}>{s.pathogenic}</span>}
              </button>
            ))}
          </div>
        </div>
        {partnerStories.map(s => (
          <p class="story" data-partner={s.gene} hidden={s.gene !== initial} set:html={s.html} />
        ))}
        <div id="structure" class="structure" data-src={href('prism/prism-viewer.js')} data-initial={initial}>
          <p class="structure-status">Loading the 3D view…</p>
        </div>
        <div class="legend">
          <span><span class="swatch" style="background:var(--chain)"></span>{gene.gene}</span>
          <span><span class="swatch" style="background:var(--partner)"></span>partner</span>
          <span><span class="swatch" style="background:var(--interface)"></span>residue at the interface</span>
          {LABEL_KEYS.map(label => <span><span class="swatch" style={`background:var(--${label})`}></span>{label} variant</span>)}
          <span class="muted">Hover the protein map or a variant to find it in 3D; click to zoom and get a link to that view.</span>
        </div>
        <script is:inline type="application/json" id="structure-data" set:html={structureJson} />
      </section>
    )
  }
  <h2>Protein map</h2>
  <div id="protein-map"><Fragment set:html={proteinMap(gene)} /></div>
  <h2>Predicted partners</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Partner</th>
          <th class="num" title={`AlphaFold DB's confidence in this interface, 0 to 1. Pairs below ${thresholds.ipsae} are left out.`}>ipSAE</th>
          <th class="num" title="AlphaFold-Multimer's confidence in the whole complex, 0 to 1. Long disordered stretches pull it down even when the interface is confident.">ipTM</th>
          <th>Interface residues</th>
          <th class="num" title="ClinVar missense variants at this partner's interface">Variants</th>
          <th title="The PDB entry holding both proteins, and the share of its contact residues the prediction also found">Experiment</th>
          <th>Complex</th>
        </tr>
      </thead>
      <tbody>
        {
          gene.partners.map(p => (
            <tr>
              <td>
                <a href={partnerHref(p.accession)}>{p.gene}</a>
                {p.modelledAs && (
                  <div
                    class="cell-note"
                    title={p.modelledAs.accession === p.accession
                      ? `AlphaFold DB modelled this partner with the ${p.modelledAs.organism} protein, which no human protein matches exactly`
                      : `AlphaFold DB modelled this partner with the ${p.modelledAs.organism} protein ${p.modelledAs.accession}, identical in sequence to human ${p.gene}`}
                  >
                    {p.modelledAs.accession === p.accession ? <i>{species(p.modelledAs.organism)}</i> : <>as <i>{species(p.modelledAs.organism)}</i> {p.modelledAs.accession}</>}
                  </div>
                )}
              </td>
              <td class="num">{p.ipsae?.toFixed(2)}</td>
              <td class="num">{p.iptm?.toFixed(2)}</td>
              <td>
                <details>
                  <summary>{p.residues}</summary>
                  <span class="muted">{p.runs}</span>
                </details>
              </td>
              <td class="num">{p.variants}</td>
              <td class="nowrap">
                {p.experiment ? (
                  <>
                    <a href={`https://www.rcsb.org/structure/${p.experiment.pdb}`}>{p.experiment.pdb.toUpperCase()}</a>{' '}
                    <span
                      class="muted"
                      title={`${p.experiment.shared} of the ${p.experiment.experimental} residues within 5 Å of ${p.gene} in the structure are in the predicted interface`}
                    >
                      {p.experiment.experimental ? `${percent(p.experiment.shared, p.experiment.experimental)} recovered` : 'no contact'}
                    </span>
                  </>
                ) : (
                  <span class="muted" title="No PDB entry holding both proteins could be compared">—</span>
                )}
              </td>
              <td class="nowrap">
                <a href={sessionUrl(complexSpec(gene.gene, p.entity, locus), JBROWSE)}>3D + genome</a> ·
                <a href={`https://alphafold.ebi.ac.uk/entry/${p.entity}`}>AFDB</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <h2>ClinVar missense variants at an interface</h2>
  <div class="toolbar filters">
    {
      LABEL_KEYS.map(label => (
        <label>
          <input type="checkbox" value={label} checked /> <Fragment set:html={chip(label)} /> {gene.counts[label]}
        </label>
      ))
    }
    {
      sameResidue.size > 0 && (
        <label title="Uncertain variants at a residue where another substitution is pathogenic">
          <input type="checkbox" id="variant-leads" /> Only uncertain at a pathogenic residue ({sameResidue.size})
        </label>
      )
    }
    <label>
      Sort by
      <select id="variant-sort">
        <option value="position">position</option>
        <option value="alphaMissense">AlphaMissense</option>
      </select>
    </label>
    <label>
      Condition
      <select id="variant-condition">
        <option value="">all</option>
        {conditions.map(([name, n]) => <option value={name}>{name} ({n})</option>)}
      </select>
    </label>
  </div>
  <p class="muted">
    <a href="https://doi.org/10.1126/science.adg7492">AlphaMissense</a> predicts how likely a substitution is to be
    pathogenic, from 0 to 1: above {am.likelyPathogenic} is likely pathogenic, below {am.likelyBenign} likely benign. It is
    a prediction from sequence and the single-protein structure, and does not see the partner.
  </p>
  <div class="table-wrap">
    <table id="variants">
      <thead>
        <tr><th>Change</th><th>ClinVar</th><th>Condition</th><th class="num">AlphaMissense</th><th title="Partners whose interface holds this residue; each opens the variant in 3D with that partner">3D</th><th>Genome</th></tr>
      </thead>
      <tbody set:html={rows} />
    </table>
  </div>
</Layout>

<script>
  import '../../scripts/variants.ts'
  import '../../scripts/structure.ts'
</script>
