---
import Layout from '../layouts/Layout.astro'
import { architectureSvg } from '../lib/architecture.ts'
import { summary } from '../lib/data.ts'
import { JBROWSE } from '../lib/site.ts'

const s = summary()
const t = s.thresholds

const svg = architectureSvg({ proteins: s.proteins, contact: t.contact, ipsae: t.ipsae, plddt: t.plddt })
---

<Layout title="How it works" nav="architecture" description="How the interface explorer is built: data sources, the Node pipeline and its libraries, and the static site and viewers it feeds.">
  <h1>How it works</h1>
  <p class="lede">
    A Node pipeline pulls public data, finds which disease-protein residues touch a predicted partner, maps them to genome
    codons, and writes JSON and bigBed files. Astro turns the JSON into a static site; JBrowse reads the bigBed tracks.
  </p>

  <figure class="architecture">
    <div class="architecture-scroll" role="img" aria-label="Architecture: UniProt, AlphaFold DB, EBI Proteins API, ClinVar, AlphaMissense, PDB, IntAct, BioGRID, Complex Portal, STRING, UCSC phyloP, gnomAD and GPCRdb feed Node scripts; their cached results in out/ are combined into bigBed tracks for JBrowse and per-gene JSON for the Astro site, which embeds the Prism 3D viewer.">
      <Fragment set:html={svg} />
    </div>
    <figcaption>
      <span class="arch-key"><span class="arch-swatch chip"></span>npm library</span>
      <span class="arch-key"><span class="arch-swatch dashed"></span>fetched by the viewer at run time</span>
      <span>
        <code>pnpm all</code> runs the scripts in order; each caches its downloads under <code>data/</code> and its results
        under <code>out/</code>.
      </span>
    </figcaption>
  </figure>

  <h2>The libraries</h2>
  <ul>
    <li>
      <a href="https://www.npmjs.com/package/g2p_mapper"><code>g2p_mapper</code></a> turns a protein's coding exons from the EBI
      Proteins API into a residue → hg38 codon map. That map places every interface residue on the genome, for the bigBed
      tracks and the conservation lookup.
    </li>
    <li>
      <a href="https://www.npmjs.com/package/p2s_mapper"><code>p2s_mapper</code></a> aligns sequences and summarises
      positions. In the GPCR post its Needleman–Wunsch aligns PDB chains SIFTS does not map, and non-human proteins, to the
      human UniProt sequence; on gene pages its position runs collapse residue lists into ranges such as 12–19, 23.
    </li>
    <li>
      <a href="https://www.npmjs.com/package/@gmod/bbi"><code>@gmod/bbi</code></a> with
      <a href="https://www.npmjs.com/package/generic-filehandle2"><code>generic-filehandle2</code></a> reads UCSC's
      phyloP100way bigWig and gnomAD v4.1 exomes bigBed over HTTP range requests, fetching only the codons it needs rather
      than the whole genome. For gnomAD that is the missense and synonymous variants seen at each residue's codon, whose
      ratio at the predicted interface against the rest of the folded surface checks the interfaces against the general
      population.
    </li>
  </ul>

  <h2>The viewers</h2>
  <ul>
    <li>
      Gene pages embed <strong>Prism</strong>, a collaborator's Mol* v6 build, which loads the AlphaFold DB complex straight
      from AlphaFold DB and colours it from the page's JSON.
    </li>
    <li>
      <a href={JBROWSE}>JBrowse 2</a> shows the explorer's bigBed tracks beside UCSC's hg38 ClinVar, RefSeq and phyloP
      tracks, and its Protein3d plugin opens a variant inside its complex next to the genome.
    </li>
  </ul>
</Layout>
