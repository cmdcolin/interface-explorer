---
import { Image } from 'astro:assets'

import Layout from '../layouts/Layout.astro'
import { geneScatter, odds, shareFigure } from '../lib/charts.ts'
import { gene, geneRows, summary } from '../lib/data.ts'
import { interfaceDiagram } from '../lib/interface-diagram.ts'
import { percent } from '../lib/html.ts'
import { posts } from '../lib/posts.ts'
import { href } from '../lib/site.ts'

const s = summary()
const genes = geneRows()
const vhl = gene('VHL')
const shown = vhl.variants.find(v => v.label === 'pathogenic')
const shownPartner = shown && vhl.partners.find(p => shown.partners.includes(p.gene))
const all = await posts()
const tiles = [
  [s.withPartner, 'disease genes with a confident predicted complex', href('genes/')],
  [s.partners, 'predicted interfaces, each in 3D and on the genome', href('genes/')],
  [s.variantsAtInterface.uncertain, 'variants of uncertain significance with a named partner they touch', href('genes/')],
  [s.leads.variants, 'leads: uncertain variants at a residue where another substitution is pathogenic', href('leads/')],
] as const
---

<Layout>
  <script is:inline>
    const [, page, arg] = location.hash.split('/')
    const routes = { gene: 'gene', isoforms: 'isoforms', gpcr: 'blog/2026-11-12-project-9-gpcrs', genes: 'genes', leads: 'leads', about: 'about' }
    if (location.hash.startsWith('#/') && routes[page]) {
      location.replace(`${routes[page]}/${arg ? `${arg}/` : ''}`)
    }
  </script>
  <section class="hero">
    <div class="hero-top">
      <div>
        <h1>Explore pathogenic variants at protein interfaces</h1>
        <p class="lede">
          See which <a href="https://alphafold.ebi.ac.uk/">AlphaFold</a> predicted partner a ClinVar missense variant
          touches, in 3D and on the genome.
        </p>
      </div>
      <Fragment set:html={interfaceDiagram()} />
    </div>
    <a class="hero-shot" href={href(`gene/${vhl.gene}/`)}>
      <img
        src={href('preview.jpg')}
        width="1400"
        height="800"
        fetchpriority="high"
        alt={`JBrowse with the VHL codon on the genome on the left, under interface and ClinVar tracks, and the same residue highlighted in the predicted VHL–${shownPartner?.gene ?? ''} complex on the right`}
      />
      <span>
        Each variant on a gene page opens in JBrowse like this: its codon on the genome beside its residue in the
        predicted complex. Here, a pathogenic {vhl.gene} variant against {shownPartner?.gene}.
      </span>
    </a>
  </section>

  <section>
    <h2>What's in it</h2>
    <div class="tiles">
      {
        tiles.map(([value, label, link]) => (
          <a class="tile" href={link}>
            <div class="value">{value.toLocaleString()}</div>
            <div class="label">{label}</div>
          </a>
        ))
      }
    </div>
    <div class="evidence">
      <p class="lede">
        Within the same disease protein, a pathogenic variant is <strong>{odds(s.enrichment.all).toFixed(1)}×</strong> as
        likely as a benign one to sit on an interface.
      </p>
      <Fragment set:html={shareFigure(s.enrichment.all)} />
    </div>
  </section>

  <section>
    <figure class="tour">
      <div class="tour-frame">
        <video preload="none" poster={href('tour.jpg')} width="1280" height="720">
          <source src={href('tour.mp4')} type="video/mp4" />
        </video>
        <button class="tour-play" type="button">
          <span class="tour-play-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span class="tour-play-title">A tour in 80 seconds</span>
        </button>
      </div>
      <figcaption>
        Find a gene, turn its predicted complex in 3D, follow a variant from the protein map to the structure, and open it
        beside the genome in JBrowse.
      </figcaption>
    </figure>
  </section>

  <section>
    <h2>Read more</h2>
    <div class="post-cards">
      {
        all.map(post => (
          <a class="post-card" href={href(`blog/${post.id}/`)}>
            <Image src={post.data.hero} alt="" widths={[360, 720]} sizes="(max-width: 640px) calc(100vw - 32px), 360px" />
            <strong>{post.data.title}</strong>
            <span class="muted">{post.data.description}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Every gene in the explorer</h2>
    <p class="lede">
      One dot per gene, {genes.length.toLocaleString()} in all. Genes high up have known pathogenic variants at an interface;
      genes far right have many unresolved ones on the same surface. Click a dot to open the gene, or
      <a href={href('genes/')}>browse the table</a>.
    </p>
    <Fragment set:html={geneScatter(genes)} />
  </section>
  <p class="note">
    Only {percent(s.withPartner, s.proteins)} of disease proteins have any predicted complex, and the complexes are
    predictions: an interface variant is a lead, not a mechanism.
  </p>
</Layout>

<script>
  import '../scripts/home.ts'
</script>
