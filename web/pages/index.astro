---
import { Image } from 'astro:assets'

import Layout from '../layouts/Layout.astro'
import { geneScatter, odds, shareFigure } from '../lib/charts.ts'
import { geneRows, summary } from '../lib/data.ts'
import { interfaceDiagram } from '../lib/interface-diagram.ts'
import { percent } from '../lib/html.ts'
import { posts } from '../lib/posts.ts'
import { href } from '../lib/site.ts'

const s = summary()
const genes = geneRows()
const all = await posts()
const tiles = [
  [s.withPartner, 'disease genes with a confident predicted partner', href('genes/')],
  [s.partners, 'predicted interfaces, each in 3D and on the genome', href('genes/')],
  [s.variantsAtInterface.uncertain, 'variants of uncertain significance with a named partner they touch', href('genes/')],
  [s.leads.variants, 'leads: uncertain variants at a residue where another substitution is pathogenic', href('leads/')],
] as const
---

<Layout>
  <script is:inline>
    const [, page, arg] = location.hash.split('/')
    const routes = { gene: 'gene', isoforms: 'isoforms', gpcr: 'blog/2026-11-12-project-9-gpcrs', genes: 'genes', leads: 'leads', about: 'about' }
    if (location.hash.startsWith('#/') && routes[page]) {
      location.replace(`${routes[page]}/${arg ? `${arg}/` : ''}`)
    }
  </script>
  <section class="hero">
    <div class="hero-top">
      <div>
        <h1>Explore pathogenic variants at protein interfaces</h1>
        <p class="lede">
          See which <a href="https://alphafold.ebi.ac.uk/">AlphaFold</a> predicted partner a ClinVar missense variant
          touches, in 3D and on the genome. Within the same disease protein, a pathogenic variant is <strong>{odds(s.enrichment.all).toFixed(1)}×</strong> as likely as a benign one to sit on an interface.
        </p>
        <Fragment set:html={interfaceDiagram()} />
      </div>
      <Fragment set:html={shareFigure(s.enrichment.all)} />
    </div>
    <div class="tiles">
      {
        tiles.map(([value, label, link]) => (
          <a class="tile" href={link}>
            <div class="value">{value.toLocaleString()}</div>
            <div class="label">{label}</div>
          </a>
        ))
      }
    </div>
    <figure class="tour">
      <video controls preload="none" poster={href('preview.jpg')} width="1280" height="720">
        <source src={href('tour.mp4')} type="video/mp4" />
      </video>
      <figcaption>
        A tour in 80 seconds: find a gene, turn its predicted complex in 3D, follow a variant from the protein map to the
        structure, and open it beside the genome in JBrowse.
      </figcaption>
    </figure>
  </section>

  <section>
    <h2>Read more</h2>
    <div class="post-cards">
      {
        all.map(post => (
          <a class="post-card" href={href(`blog/${post.id}/`)}>
            <Image src={post.data.hero} alt="" widths={[360, 720]} sizes="(max-width: 640px) calc(100vw - 32px), 360px" />
            <strong>{post.data.title}</strong>
            <span class="muted">{post.data.description}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Every gene in the explorer</h2>
    <p class="lede">
      One dot per gene, {genes.length.toLocaleString()} in all. Genes high up have known pathogenic variants at an interface;
      genes far right have many unresolved ones on the same surface. Click a dot to open the gene, or
      <a href={href('genes/')}>browse the table</a>.
    </p>
    <Fragment set:html={geneScatter(genes)} />
  </section>
  <p class="note">
    Only {percent(s.withPartner, s.proteins)} of disease proteins have any predicted partner, and the complexes are
    predictions: an interface variant is a lead, not a mechanism.
  </p>
</Layout>

<script>
  import '../scripts/home.ts'
</script>
