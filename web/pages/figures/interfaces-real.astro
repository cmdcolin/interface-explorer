---
import Layout from '../../layouts/Layout.astro'
import { gene } from '../../lib/data.ts'
import { proteinMap } from '../../lib/maps.ts'
import { href } from '../../lib/site.ts'

const prph2 = gene('PRPH2')
---

<Layout title="Interfaces hero figure" indexed={false}>
  <div class="hero-figure">
    <h2>PRPH2's predicted interface residues and ClinVar variants</h2>
    <Fragment set:html={proteinMap(prph2)} />
    <h2>Share of each experimental interface the prediction covers</h2>
    <img src={href('figures/recall.svg')} width="1264" height="569" alt="" />
  </div>
</Layout>

<style>
  .hero-figure {
    width: 1360px;
    max-width: none;
    margin-left: calc(50% - 680px);
    padding: 40px 48px;
    background: var(--surface);
  }

  h2 {
    margin: 0 0 16px;
    font-size: 28px;
  }

  h2:not(:first-child) {
    margin-top: 40px;
  }
</style>
