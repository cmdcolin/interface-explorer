---
import Layout from '../../layouts/Layout.astro'
import { diseaseRows } from '../../lib/data.ts'
import { wordCloud } from '../../lib/wordcloud.ts'

const width = 1360
const height = 640
const words = wordCloud(
  diseaseRows()
    .toSorted((a, b) => b.pathogenic - a.pathogenic)
    .slice(0, 400)
    .map(d => ({ text: d.name, weight: d.pathogenic, group: d.pairs > 0 })),
  width,
  height,
  14,
  44,
)
---

<Layout title="Diseases hero figure" indexed={false}>
  <div class="hero-figure" style={`width:${width}px;height:${height}px`}>
    {words.map(w => (
      <span
        class:list={['word', { paired: w.group }]}
        style={`left:${w.x}px;top:${w.y}px;font-size:${w.size}px`}
      >{w.text}</span>
    ))}
  </div>
</Layout>

<style>
  .hero-figure {
    position: relative;
    max-width: none;
    margin-left: calc(50% - 680px);
    background: var(--surface);
    overflow: hidden;
  }

  .word {
    position: absolute;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    line-height: 1;
    font-weight: 600;
    color: var(--text-2);
  }

  .paired {
    color: var(--interface);
  }
</style>
