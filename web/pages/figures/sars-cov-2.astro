---
import { Image } from 'astro:assets'

import virion from '../../content/blog/sources/cdc-sars-cov-2.jpg'
import Layout from '../../layouts/Layout.astro'
import { viralContacts } from '../../lib/viral.ts'

const v = viralContacts()
const rows = v.contacts.filter(c => c.variants.length).slice(0, 7)
---

<Layout title="SARS-CoV-2 hero figure" indexed={false}>
  <div class="hero-figure">
    <Image class="virion" src={virion} alt="" width={520} />
    <div class="card">
      <h2>Where SARS-CoV-2 holds a human disease protein</h2>
      <table>
        <thead>
          <tr>
            <th>Gene</th>
            <th>Viral protein</th>
            <th>Entry</th>
            <th class="num">Residues</th>
            <th>ClinVar on them</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(c => (
            <tr>
              <td>{c.gene}</td>
              <td>{c.protein}</td>
              <td>{c.pdb}</td>
              <td class="num">{c.residues.length}</td>
              <td>
                {c.variants.map(variant => (
                  <>
                    <span>{variant.change}</span>{' '}
                    <span class={`count ${variant.label}`}>{variant.label}</span>{' '}
                  </>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<style>
  .hero-figure {
    position: relative;
    width: 1360px;
    max-width: none;
    margin-left: calc(50% - 680px);
    padding: 112px 48px 48px;
    background: var(--surface);
  }

  .virion {
    position: absolute;
    right: 40px;
    top: 8px;
    z-index: 1;
    width: 200px;
    height: auto;
    mix-blend-mode: multiply;
  }

  .card {
    position: relative;
    padding: 24px 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 12%);
  }

  h2 {
    margin: 0 0 12px;
    font-size: 26px;
  }

  table {
    font-size: 19px;
  }
</style>
