---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import '../styles/site.css'
import { JBROWSE, href } from '../lib/site.ts'

interface Props {
  title?: string
  description?: string
  nav?: 'genes' | 'leads' | 'isoforms' | 'blog' | 'architecture' | 'comparison' | 'about'
  indexed?: boolean
  image?: ImageMetadata
}

const DEFAULT_DESCRIPTION =
  'ClinVar missense variants at predicted protein–protein interfaces of human disease genes, each one opened on the genome beside the 3D complex.'
const { title, description = DEFAULT_DESCRIPTION, nav, indexed = true, image } = Astro.props
const fullTitle = title ? `${title} · Interface explorer` : 'Interface explorer'
const canonical = new URL(Astro.url.pathname, Astro.site)
const preview = image
  ? (await getImage({ src: image, width: 1400, height: 800, format: 'jpg' })).src
  : href('preview.jpg')
const previewUrl = new URL(preview, Astro.site)
const explore = [
  ['genes', 'Genes'],
  ['leads', 'Leads'],
  ['isoforms', 'Isoforms'],
] as const
const exploreActive = explore.some(([key]) => key === nav)
const links = [
  ['blog', 'Blog'],
  ['architecture', 'How it works'],
  ['comparison', 'Comparison'],
  ['about', 'About'],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {indexed && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? 'Interface explorer: disease variants on predicted protein interfaces'} />
    <meta property="og:description" content={description} />
    {indexed && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1400" />
    <meta property="og:image:height" content="800" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('logo.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
  </head>
  <body>
    <header class="site-header">
      <div class="brand-group">
        <a class="brand" href={href()}>
          <img class="brand-logo" src={href('logo.svg')} alt="" />
          Interface explorer
        </a>
        <a
          class="event-badge"
          href="https://biohackathon-europe.org/"
          style={`--logo: url(${href('biohackathon-logo.svg')})`}
        >
          <span class="event-logo" role="img" aria-label="BioHackathon Europe"></span>
          BioHackathon EU 2026 project
        </a>
      </div>
      <nav>
        <details class="nav-menu">
          <summary aria-current={exploreActive ? 'true' : undefined}>Explore</summary>
          <div class="nav-menu-items">
            {
              explore.map(([key, label]) => (
                <a href={href(`${key}/`)} aria-current={nav === key ? 'page' : undefined}>
                  {label}
                </a>
              ))
            }
          </div>
        </details>
        {
          links.map(([key, label]) => (
            <a href={href(`${key}/`)} aria-current={nav === key ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
        <a href={JBROWSE}>Genome browser</a>
      </nav>
    </header>
    <main id="app">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="event-note" style={`--logo: url(${href('biohackathon-logo.svg')})`}>
        <span class="event-logo" role="img" aria-label="BioHackathon Europe"></span>
        Interface explorer is a <a href="https://biohackathon-europe.org/">BioHackathon Europe 2026</a> project,
        created by Colin Diesh on Team 9 with Claude AI assistance.
      </p>
      Prototype. Predicted complexes from
      <a href="https://alphafold.ebi.ac.uk/">AlphaFold DB</a> (CC-BY 4.0),
      variants from <a href="https://www.ncbi.nlm.nih.gov/clinvar/">ClinVar</a> (NCBI),
      proteins and isoforms from <a href="https://www.uniprot.org/">UniProt</a>,
      experimental structures from <a href="https://www.rcsb.org/">RCSB PDB</a> and
      <a href="https://www.ebi.ac.uk/pdbe/">PDBe</a>, selected with <a href="https://gpcrdb.org/">GPCRdb</a>,
      gene coordinates via the <a href="https://www.ebi.ac.uk/proteins/api/doc/">EBI Proteins API</a>,
      conservation from <a href="https://genome.ucsc.edu/">UCSC</a>'s 100-way vertebrate phyloP,
      viewer <a href="https://jbrowse.org/jb2/">JBrowse 2</a>.
      <a href="https://github.com/cmdcolin/interface-explorer">Source</a>.
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.nav-menu')
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !menu?.contains(event.target)) {
          menu?.removeAttribute('open')
        }
      })
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          menu?.removeAttribute('open')
        }
      })
    </script>
  </body>
</html>
